# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:5173          # CORS origin and links in SMS
PUBLIC_BASE_URL=http://localhost:3001     # set to your ngrok https URL for sandbox webhooks
SHORT_LINK_BASE=http://localhost:5173/v   # used in SMS: {SHORT_LINK_BASE}/{receiptId}
TZ_DISPLAY=Africa/Nairobi
DEMO_MODE=true                            # enables /api/demo/* and the phone simulator

# ── Sessions and secrets ──────────────────────────────
SESSION_TTL_HOURS=8
COOKIE_SECURE=false                       # true when served over https
WEBHOOK_TOKEN=                            # path secret for all webhooks; generate a long random string
ID_ENCRYPTION_KEY=                        # AES-256-GCM key for picker ID numbers, base64 32 bytes
# generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── Blockchain ────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_INFO_PATH=src/contract.json
INDEXER_POLL_MS=2000
INDEXER_BLOCK_BATCH=500
CONFIRMATIONS=1
TX_WAIT_TIMEOUT_MS=60000

# Demo only (local chain 31337): Hardhat practice private keys, comma-separated,
# in this order: admin(#0), centre(#1), brandA(#2), brandB(#3). Never real keys.
DEMO_SIGNER_KEYS=

# ── Business rules ────────────────────────────────────
REQUIRE_SCALE_PHOTO=true
MAX_WEIGHT_KG=2000
MAX_BACKDATE_DAYS=7
DISPUTE_WINDOW_HOURS=72
CLAIM_HOLD_HOURS=0                        # hours after anchoring before a receipt is listed as claimable (72 in "realistic" mode)
SMS_ON_DRAFT=false

# ── SMS / USSD ────────────────────────────────────────
SMS_PROVIDER=mock                         # mock | africastalking
USSD_PROVIDER=mock                        # mock | africastalking
USSD_CODE=*384*123#
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=                             # blank in sandbox, or your sandbox shortcode
AT_ENVIRONMENT=sandbox                    # sandbox | production

# ── M-Pesa payouts ───────────────────────────────────
PAYOUT_PROVIDER=mock                      # mock | daraja
MOCK_PAYOUT_DELAY_MS=2000
MOCK_PAYOUT_FAIL_PHONES=                  # comma-separated phones that always fail (demo)
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                          # Party A from the Daraja test credentials page
MPESA_INITIATOR_NAME=                     # e.g. testapi
MPESA_INITIATOR_PASSWORD=                 # used to build the security credential
MPESA_CERT_PATH=certs/sandbox.cer         # Daraja sandbox certificate
MPESA_SECURITY_CREDENTIAL=                # optional: paste a pre-generated credential instead
MPESA_COMMAND_ID=BusinessPayment
MPESA_SANDBOX_FORCE_MSISDN=254708374149   # sandbox can only pay its test number; real picker phone is kept in our records

# ── Photo storage ────────────────────────────────────
STORAGE_PROVIDER=ipfs-local               # ipfs-local | pinata | none
IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs
PINATA_JWT=
PHOTO_MAX_BYTES=8388608
PHOTO_MAX_DIMENSION=1600
